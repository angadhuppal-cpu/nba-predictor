# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
PORT=5000
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration
DATABASE_PATH=../database/nba_data.db

# NBA API Configuration
NBA_STATS_API_URL=https://stats.nba.com/stats
NBA_API_RATE_LIMIT=60

# Cache Configuration
CACHE_TTL=900
CACHE_ENABLED=true

# Prediction Model Configuration
MODEL_PATH=../models
MODEL_VERSION=1.0.0

# Logging
LOG_LEVEL=INFO
LOG_FILE=../logs/nba_predictor.log

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Data Update Schedule (cron format)
DATA_UPDATE_SCHEDULE=0 */6 * * *

# Feature Flags
ENABLE_ML_PREDICTIONS=true
ENABLE_ADVANCED_ANALYTICS=true
ENABLE_CACHING=true

# AI Gambling Line Advisor (Claude API)
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Override the model if you want to (default is claude-opus-4-7)
NBA_AI_MODEL=claude-opus-4-7
